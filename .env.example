# ==========================================
# MedTrack Configuration Environment
# ==========================================

# Execution Mode:
# 'auto'  - Automatically uses AWS if valid credentials are provided; falls back to Local Mode.
# 'local' - Always run in Local Mode (offline, no AWS credentials needed, data stored in data/local_db.json).
# 'aws'   - Force AWS Mode (requires valid AWS credentials and active AWS DynamoDB/SNS resources).
AWS_MODE=auto

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=medtrack-dev-secret-key-change-in-production

# AWS Configuration (Leave blank or as placeholders for Local Mode)
# When you have AWS credentials, paste them here and MedTrack will automatically switch to AWS!
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
SNS_ENDPOINT_URL=

# DynamoDB Tables (Used in both AWS Mode and Local Mock Mode)
DYNAMODB_USERS_TABLE=medtrack-users
DYNAMODB_DOCTORS_TABLE=medtrack-doctors
DYNAMODB_PATIENTS_TABLE=medtrack-patients
DYNAMODB_APPOINTMENTS_TABLE=medtrack-appointments
DYNAMODB_DIAGNOSIS_TABLE=medtrack-diagnosis
DYNAMODB_NOTIFICATIONS_TABLE=medtrack-notifications

# SNS Topics (Configured in AWS Mode; in Local Mode, alerts are logged to data/sns_notifications.log)
SNS_APPOINTMENT_ALERTS_TOPIC=arn:aws:sns:us-east-1:123456789012:MedTrack-Appointment-Alerts
SNS_DIAGNOSIS_UPDATES_TOPIC=arn:aws:sns:us-east-1:123456789012:MedTrack-Diagnosis-Updates

# Application URL
APP_URL=http://localhost:5000